# ---------------------------------------------------------------------------
# VetAnimals environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project URL and publishable (anon) key from:
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Stripe (optional — enables card payments at checkout) ------------------
# Publishable key from: Stripe Dashboard → Developers → API keys
# (pk_test_... for testing, pk_live_... for production)
VITE_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (set with `supabase secrets set`, NOT in
# .env.local — these never reach the browser):
#
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase secrets set STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
# ---------------------------------------------------------------------------
