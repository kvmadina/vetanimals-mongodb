# ---------------------------------------------------------------------------
# VetAnimals environment variables
# Copy to .env and fill in real values. NEVER commit .env.
#
# Everything here is server-side: Vite only exposes VITE_* variables to the
# browser, so none of these reach the client bundle.
# ---------------------------------------------------------------------------

# --- MongoDB (required) -----------------------------------------------------
# Atlas → Clusters → Connect → Drivers, then:
#   1. replace <db_password> with your DATABASE USER password (not your
#      mongodb.com website password)
#   2. add the database name after .mongodb.net — without it Mongoose writes
#      to a database called "test"
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vetanimals?retryWrites=true&w=majority

# --- Auth (required) --------------------------------------------------------
# Secret used to sign login tokens. Use a long random string in production;
# changing it signs every user out.
JWT_SECRET=change-me-to-a-long-random-string

# --- Server -----------------------------------------------------------------
# Port the Express API listens on. vite.config.js proxies /api to it.
PORT=3000
